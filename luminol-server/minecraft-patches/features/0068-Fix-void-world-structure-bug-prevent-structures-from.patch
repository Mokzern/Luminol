+++ b/net/minecraft/world/level/levelgen/structure/structures/ShipwreckPieces.java
@@ -165,7 +165,20 @@ public class ShipwreckPieces {
                     i1 /= i2;
                 }
 
-                this.adjustPositionHeight(this.isBeached ? this.calculateBeachedPosition(i, random) : i1);
+                // Luminol start - prevent shipwrecks from spawning at world bottom in void worlds
+                int targetHeight = this.isBeached ? this.calculateBeachedPosition(i, random) : i1;
+                if (me.earthme.luminol.config.modules.fixes.VoidWorldStructureFixConfig.enabled) {
+                    String worldName = level.getLevel().getWorld().getName();
+                    if (me.earthme.luminol.config.modules.fixes.VoidWorldStructureFixConfig.affectedWorlds.contains(worldName)) {
+                        int worldMinY = level.getMinY();
+                        int minAllowedY = worldMinY + me.earthme.luminol.config.modules.fixes.VoidWorldStructureFixConfig.minDistanceFromBottom;
+                        if (targetHeight < minAllowedY) {
+                            return;
+                        }
+                    }
+                }
+                this.adjustPositionHeight(targetHeight);
+                // Luminol end
                 super.postProcess(level, structureManager, generator, random, box, chunkPos, pos);
             }
         }
